name: Build NOVA JARVIS APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check project ZIP
        run: |
          ls -la
          test -f NOVA-JARVIS-Android-Project.zip

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Install SDK packages
        run: sdkmanager 'platform-tools' 'platforms;android-34' 'build-tools;34.0.0'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Extract project
        run: unzip -q NOVA-JARVIS-Android-Project.zip -d source

      - name: Build APK
        run: gradle --no-daemon -p source/nova-jarvis/android assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: nova-jarvis-debug-apk
          path: source/nova-jarvis/android/app/build/outputs/apk/debug/app-debug.apk
